# TechCart Server Environment Configuration

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# MongoDB Connection String (MongoDB Compass / Local mongod or MongoDB Atlas)
# Local Compass default: mongodb://127.0.0.1:27017/techcart
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/techcart?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/techcart

# JSON Web Token Secret & Expiration
JWT_SECRET=techcart_super_secret_jwt_key_2026_secure
JWT_EXPIRE=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
